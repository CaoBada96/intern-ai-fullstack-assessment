{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-log/log-prompt.mjs\" --tool claude-code --capture hook", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-log/log-event.mjs\" --event post-tool --tool claude-code", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/ai-log/log-event.mjs\" --event stop --tool claude-code", "timeout": 10 }
        ]
      }
    ]
  }
}
